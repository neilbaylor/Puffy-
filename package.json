{
  "name": "puffy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && npm run build:server",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "start": "node server.mjs",
    "build:server": "esbuild server/battle.ts server/users.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --out-extension:.js=.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
